# Copier en .env (jamais commité) puis : npm start
# Adresse publique du site (CORS + retours de paiement)
PUBLIC_SITE_URL=https://aeloria.netlify.app
# Origines supplémentaires autorisées (aperçu, tests), séparées par des virgules
CORS_EXTRA_ORIGINS=

# Écoute locale ; exposer en HTTPS via Cloudflare Tunnel ou Caddy (voir README)
HOST=127.0.0.1
PORT=8787
# « oui » si un proxy inverse ajoute X-Forwarded-For (limitation des tentatives par IP)
TRUST_PROXY=oui

DATABASE_FILE=data/aeloria.db
PACKS_FILE=packs.json

# Stripe en MODE TEST (tableau de bord Stripe > Développeurs > Clés API, interrupteur « Mode test »)
STRIPE_SECRET_KEY=sk_test_xxx
# Secret du webhook (Développeurs > Webhooks, URL : https://<api>/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Paiements réels : refusés tant que ce n'est pas « oui »
ALLOW_LIVE_PAYMENTS=non

# Même secret que la variable AELORIA_CREDIT_SECRET du serveur Minecraft (32 caractères minimum)
AELORIA_CREDIT_SECRET=
# Passerelle crédits du serveur MAIN (boutique.json : paymentBridgeEnabled=true, paymentBridgePort=8099)
CREDIT_BRIDGE_URL=http://127.0.0.1:8099
